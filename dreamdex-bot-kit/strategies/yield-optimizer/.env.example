# Copy to .env and fill in. Inherits PRIVATE_KEY / NETWORK from the repo root .env
# if you run from there; otherwise set them here too.
PRIVATE_KEY=0x...
NETWORK=testnet

# Safe by default: logs intended quotes without sending transactions.
DRY_RUN=true

YO_SYMBOL=SOMI:USDso

# Protocol yield σ — pick ONE of these (raw preferred once calibrated).
# REST / getPoolParams do not expose σ today; calibrate with startup band log.
# YO_SIGMA_RAW=100000000000000   # raw on-chain price units (quote decimals)
YO_SIGMA_TICKS=50                 # fallback: σ = ticks × tickSize (raw)

# Minimum Gaussian weight to stay "in band" (default ≈ e^{-1/2} = one σ).
YO_MIN_WEIGHT=0.607

# Reservation-price (Avellaneda-lite) knobs — not the protocol σ.
YO_HALF_SPREAD_BPS=5
YO_GAMMA=0.5
YO_K_VOL=2.0
YO_VOL_LOOKBACK=60
YO_TARGET_INVENTORY_USDSO=0
YO_NOTIONAL_USDSO=20
YO_MAX_INVENTORY_USDSO=100

# Requote / risk
YO_REQUOTE_TRIGGER_BPS=3
YO_REQUOTE_COOLDOWN_MS=2000
YO_REFRESH_INTERVAL_MS=5000
YO_MAX_BOOK_SPREAD_BPS=50
YO_MAX_TOXIC_BPS=30
YO_STALE_MS=15000
YO_MIN_GAS_SOMI=0.05
YO_FLATTEN_ABOVE_USDSO=0
YO_MODE=quote

# Optional CSV logs for edge-analytics (empty = disabled).
# YO_TRADES_CSV=data/yo-trades.csv
# YO_MIDS_CSV=data/yo-mids.csv
# YO_YIELD_CSV=data/yo-yield.csv

# Optional APR estimate inputs (operator settlement schedule — not on-chain).
# YO_POOL_USDSO=
# YO_SETTLE_SEC=
