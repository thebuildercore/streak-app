# Copy to .env and fill in. Inherits PRIVATE_KEY / NETWORK from the repo root .env
# if you run from there; otherwise set them here too.
PRIVATE_KEY=0x...
NETWORK=testnet

# Safe by default: logs intended quotes (and refill) without sending transactions.
# Set DRY_RUN=false to go live.
DRY_RUN=true

SYMBOL=SOMI:USDso
TREASURY_DEPLOY_RATIO=0.6
TREASURY_MIN_IDLE_USDSO=1000
TREASURY_SPREAD_BPS=12
TREASURY_REQUOTE_TRIGGER_BPS=5
TREASURY_TICK_MS=5000
TREASURY_MODE=quote
# TREASURY_MAX_NOTIONAL_USDSO=

# Optional: IOC-convert idle USDC.e → USDso on mainnet before / alongside quoting.
# Off by default. USDC.e:USDso is mainnet-only in the kit address book.
TREASURY_SWAP_ENABLED=false
TREASURY_SWAP_MARKET=USDC.e:USDso
TREASURY_SWAP_AMOUNT=500
TREASURY_SWAP_MAX_SLIPPAGE_BPS=10
TREASURY_SWAP_COOLDOWN_MS=300000
